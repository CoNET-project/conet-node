# conet-node: network process. No keys on disk; it asks conet-signer.
[Unit]
Description=CoNET node
After=network-online.target conet-signer.service
Requires=conet-signer.service
# Keep restarting so the boot guard can count failed starts and roll back (security §3.7).
StartLimitIntervalSec=0

[Service]
User=conet-node
Group=conet-node
SupplementaryGroups=conet-signer
StateDirectory=conet-node
# Offline boot guard (not part of the binary it guards): after 3 starts of a new version
# without reaching "healthy", switch back to the previous release and blacklist it.
ExecStartPre=+/opt/conet-node/updater/conet-boot-guard --root /opt/conet-node
ExecStart=/opt/conet-node/current/conet-node \
  --listen 0.0.0.0:80 \
  --tls-listen 0.0.0.0:443 \
  --acme-cache /var/lib/conet-node/acme \
  --signer-socket /run/conet-signer/signer.sock \
  --rpc ${CONET_RPC} \
  --api-base ${BEAMIO_API_BASE} \
  --public-ip ${CONET_PUBLIC_IP} \
  --mailbox-db /var/lib/conet-node/mailbox.redb \
  --health-listen 127.0.0.1:9180
EnvironmentFile=/etc/conet-node/node.env
Restart=always
RestartSec=30s
LimitCORE=0
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
