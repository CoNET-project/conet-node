# conet-node: network process (mailbox, entry, forwarding). Holds no keys: it asks conet-signer.
# Listens on :80 and :443 of both IPv4 and IPv6 ([::] is dual-stack while net.ipv6.bindv6only=0).
[Unit]
Description=CoNET node
Documentation=https://github.com/CoNET-project/conet-node
After=network-online.target conet-signer.service
Wants=network-online.target
Requires=conet-signer.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=conet-node
Group=conet-node
SupplementaryGroups=conet-signer
StateDirectory=conet-node conet-node/evidence
StateDirectoryMode=0750
EnvironmentFile=/etc/conet-node/node.env
ExecStart=/usr/lib/conet-node/conet-node \
  --listen [::]:80 \
  --tls-listen [::]:443 \
  --acme-cache /var/lib/conet-node/acme \
  --signer-socket /run/conet-signer/signer.sock \
  --rpc ${CONET_RPC} \
  --api-base ${BEAMIO_API_BASE} \
  --public-ip ${CONET_PUBLIC_IP} \
  --mailbox-db /var/lib/conet-node/mailbox.redb \
  --health-listen 127.0.0.1:9180 \
  --evidence-log /var/lib/conet-node/evidence/evidence.jsonl
Restart=always
RestartSec=10
LimitCORE=0
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027

[Install]
WantedBy=multi-user.target
