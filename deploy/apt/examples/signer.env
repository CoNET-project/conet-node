# /etc/conet-node/signer.env (create it; the package never writes it). No secrets here.
# The signer signs NodeRegistryV2 statements only on request; the chat pilot never requests one
# (NodeRegistryV2 is not deployed, BindNode needs --allow-bind, which the unit does not pass).
# The domain still needs an address: use the NodeRegistryV2 address once it exists, the zero
# address until then.
CONET_NODE_REGISTRY=0x0000000000000000000000000000000000000000
