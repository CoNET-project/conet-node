# /etc/conet-node/signer.env (create it; the package never writes it). No secrets here.
# PLACEHOLDER for the chat pilot: NodeRegistryV2 is not deployed, so the all-zero address stands in.
# The chat pilot requests no NodeRegistryV2 statement, and BindNode is refused because the unit does
# not pass --allow-bind. Replace this value with the real NodeRegistryV2 address when that contract
# is deployed, before any statement is requested.
CONET_NODE_REGISTRY=0x0000000000000000000000000000000000000000
